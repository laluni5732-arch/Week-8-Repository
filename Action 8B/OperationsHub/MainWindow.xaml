<Window x:Class="OperationsHub.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Operations Hub" Width="1180" Height="900" MinWidth="900" MinHeight="760"
 Background="#0B1020" Foreground="#EEF4FF" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="PanelBrush" Color="#151D33"/>
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#2B3858"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#AAB8D4"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#7C8CFF"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#7C8CFF"/><Setter Property="Foreground" Value="#0B1020"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="13,9"/>
   <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#0D1427"/>
   <Setter Property="Foreground" Value="#F4F7FF"/><Setter Property="BorderBrush" Value="#344363"/>
   <Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="Margin" Value="0,5,0,10"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="#0D1427"/><Setter Property="Foreground" Value="#F4F7FF"/>
   <Setter Property="BorderBrush" Value="#344363"/><Setter Property="Padding" Value="5"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="PanelCard" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/>
   <Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/>
  </Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border CornerRadius="22" Padding="26" Margin="0,0,0,20" BorderBrush="#4755A5" BorderThickness="1">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#222B58" Offset="0"/><GradientStop Color="#17213B" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="CS110  /  PERSONAL WORKSPACE" Foreground="#A9B6FF" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="Operations Hub" FontSize="36" FontWeight="Bold" Margin="0,8,0,5"/>
      <TextBlock Text="Plan your next move. Keep your tools close. Capture what you build." Foreground="#C4CEE8" FontSize="15"/>
     </StackPanel>
     <Border Grid.Column="1" Background="#303D73" CornerRadius="14" Padding="16" VerticalAlignment="Center"><StackPanel>
      <TextBlock Text="FOCUS MODE" Foreground="#B8C3FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock Text="Build • Test • Reflect" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
     </StackPanel></Border>
    </Grid>
   </Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource PanelCard}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="01  /  TASK BOARD" FontSize="12" Foreground="#A9B6FF" FontWeight="Bold"/><TextBlock Text="What needs doing?" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,12"/></StackPanel>
      <TextBox x:Name="txtEntry" Grid.Row="1" ToolTip="Enter a task or inventory item" />
      <ListBox x:Name="lstItems" Grid.Row="2" MinHeight="155" MaxHeight="260"/>
      <WrapPanel Grid.Row="3" Margin="0,14,0,0"><Button Content="＋ Add task" Click="Add_Click"/><Button Content="Remove selected" Click="Remove_Click" Background="#293653" Foreground="#EEF4FF"/></WrapPanel>
     </Grid>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
     <StackPanel>
      <TextBlock Text="02  /  FOCUS TIMER" FontSize="12" Foreground="#A9B6FF" FontWeight="Bold"/>
      <TextBlock Text="Make room for deep work" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,3"/>
      <TextBlock Text="A 25-minute session, one step at a time." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,15"/>
      <Border Background="#0D1427" CornerRadius="14" Padding="18" Margin="0,0,0,14">
       <StackPanel><TextBlock x:Name="txtTimer" Text="25:00" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#9DE8F5"/>
        <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0"><Button Content="Start / Pause" Click="Timer_Click"/><Button Content="Reset" Click="Reset_Click" Background="#293653" Foreground="#EEF4FF"/></WrapPanel>
       </StackPanel>
      </Border>
      <TextBlock Text="TIP" Foreground="#A9B6FF" FontWeight="Bold" FontSize="11"/>
      <TextBlock Text="Choose one small action, then record what you learned." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource PanelCard}">
     <StackPanel>
      <TextBlock Text="03  /  QUICK LINKS" FontSize="12" Foreground="#A9B6FF" FontWeight="Bold"/>
      <TextBlock Text="Your launchpad" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,3"/>
      <TextBlock Text="Save course pages, documentation, repositories, and tools here." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
      <TextBlock Text="Link name" Foreground="#D6DDF0"/>
      <TextBox x:Name="txtLinkName" Margin="0,4,0,8" ToolTip="Example: Course Canvas"/>
      <TextBlock Text="Website URL" Foreground="#D6DDF0"/>
      <TextBox x:Name="txtLinkUrl" Margin="0,4,0,10" ToolTip="https://example.com"/>
      <WrapPanel><Button Content="＋ Save link" Click="AddLink_Click"/><Button Content="Open selected" Click="OpenLink_Click" Background="#293653" Foreground="#EEF4FF"/><Button Content="Remove link" Click="RemoveLink_Click" Background="#293653" Foreground="#EEF4FF"/></WrapPanel>
      <ListBox x:Name="lstLinks" DisplayMemberPath="Name" MinHeight="100" MaxHeight="180" Margin="0,5,0,0" SelectionChanged="LinkSelectionChanged"/>
      <TextBlock Text="Select a link and choose Open selected. Only HTTP and HTTPS addresses are accepted." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
     <StackPanel>
      <TextBlock Text="04  /  WORK LOG" FontSize="12" Foreground="#A9B6FF" FontWeight="Bold"/>
      <TextBlock Text="Capture the work" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,3"/>
      <TextBlock Text="Use this space for a team contract, reflection, or progress report." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
      <TextBox x:Name="txtDocument" Height="170" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
      <WrapPanel><Button Content="Export report" Click="Save_Click"/><Button Content="Reopen text" Click="Open_Click" Background="#293653" Foreground="#EEF4FF"/></WrapPanel>
     </StackPanel>
    </Border>
   </Grid>
   <Border Grid.Row="3" Style="{StaticResource PanelCard}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="05  /  ARTWORK &amp; INSPIRATION" FontSize="12" Foreground="#A9B6FF" FontWeight="Bold"/>
      <TextBlock Text="Keep a visual reference nearby" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,10"/>
      <Image x:Name="imgArtwork" Height="150" Stretch="Uniform" HorizontalAlignment="Left"/>
      <TextBlock Text="Choose a local image to use as a visual reference. Its file path is included in exported reports." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
     </StackPanel>
     <Button Grid.Column="1" Click="Image_Click" VerticalAlignment="Top" Margin="12,0,0,0">
      <StackPanel Orientation="Horizontal"><Image x:Name="imgButton" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="Choose artwork" VerticalAlignment="Center"/></StackPanel>
     </Button>
    </Grid>
   </Border>
   <Border Grid.Row="4" Background="#121A2D" BorderBrush="#2B3858" BorderThickness="1" CornerRadius="12" Padding="14">
    <StackPanel><TextBlock Text="STATUS / SYSTEM FEEDBACK" Foreground="#A9B6FF" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="txtStatus" Text="Ready. Add a task, save a quick link, or start a focus session." Foreground="#C8D5EE" Margin="0,5,0,0"/></StackPanel>
   </Border>
  </Grid>
 </ScrollViewer>
</Window>
